{
	"name": "@rhizome/core",
	"version": "0.1.0",
	"description": "Shared logic and UI components for the TuneTrees ecosystem",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"scripts",
		"supabase/seeds"
	],
	"scripts": {
		"build": "vite build",
		"db:remote:backup": "node scripts/backup-supabase-linked.mjs",
		"db:local:auth:seed": "bash scripts/seed-shared-auth-users-local.sh",
		"db:local:auth:reset": "bash scripts/reset-shared-auth-users-local.sh",
		"db:local:auth:reset:all": "bash scripts/reset-shared-auth-users-local.sh --all",
		"dev": "vite build --watch",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome lint .",
		"format": "biome format .",
		"format:write": "biome format --write .",
		"yalc:push": "npm run build && yalc publish --push",
		"prepare": "[ -f node_modules/.bin/vite ] && npm run build || echo '@rhizome/core: dist is pre-built; skipping vite build (no devDeps)'"
	},
	"devDependencies": {
		"@solidjs/router": "^1.0.0",
		"solid-js": "^1.9.14",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"vite-plugin-dts": "^5.0.3",
		"vite-plugin-solid": "^2.11.14",
		"yalc": "^1.0.0-pre.53"
	},
	"peerDependencies": {
		"@solidjs/router": "^0.15.0",
		"solid-js": "^1.9.14"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.110.9"
	}
}
